# Static LightRAG configuration (stock image, documented environment only).
# Secrets and Postgres connection details come from docker-compose environment variables;
# nothing here is generated by the backend and LightRAG never needs a restart when a chat
# model alias changes. Embedding/vision changes are corpus re-indexes (PROTOCOL §12.4).

SUMMARY_LANGUAGE=English
LIGHTRAG_API_KEY=

# All-in-one Postgres storage.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# Embeddings go through the internal gateway; the alias is stable.
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=fs-embedding
EMBEDDING_BINDING_HOST=http://backend:8000/internal/llm/v1
EMBEDDING_DIM=1024

# Ingestion extraction and keyword extraction go through the gateway.
EXTRACT_LLM_BINDING=openai
EXTRACT_LLM_MODEL=fs-extract
EXTRACT_LLM_BINDING_HOST=http://backend:8000/internal/llm/v1
QUERY_LLM_BINDING=openai
QUERY_LLM_MODEL=fs-extract
QUERY_LLM_BINDING_HOST=http://backend:8000/internal/llm/v1
KEYWORD_LLM_BINDING=openai
KEYWORD_LLM_MODEL=fs-extract
KEYWORD_LLM_BINDING_HOST=http://backend:8000/internal/llm/v1

# Two indexing workers share this instance. Two parallel inserts measured about 1.5x the
# one-worker throughput with no failures; keep MAX_ASYNC at four so the shared provider and
# Postgres stay within the tested envelope (DECISIONS.md D74).
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
WORKING_DIR=/app/data
LOG_LEVEL=INFO
