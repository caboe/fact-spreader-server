{
	admin off
}

localhost:443 {
	tls internal
	encode zstd gzip

	# The internal LLM gateway must never be reachable through the edge.
	@internal path /internal/* /internal
	handle @internal {
		respond 404
	}
	handle /metrics {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /v1/* {
		reverse_proxy backend:8000 {
			# Server-sent events must not be buffered by the proxy.
			flush_interval -1
		}
	}
	handle /healthz {
		reverse_proxy backend:8000
	}
	handle /readyz {
		reverse_proxy backend:8000
	}

	# The handbook ships with the instance, so help works without internet access.
	redir /handbook /handbook/ 308
	handle /handbook/* {
		root * /srv
		try_files {path} {path}/index.html
		file_server
		header X-Robots-Tag "noindex"
		# Pagefind compiles a WebAssembly module in the browser. Scope the exception to
		# the handbook; the SPA and the API keep the strict policy below.
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self'; font-src 'self'"
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Unknown handbook paths get the handbook's own 404 page. The SPA catch-all above
	# always finds index.html, and proxied API errors are not Caddy errors.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv
			rewrite * /handbook/404.html
			file_server
			header X-Robots-Tag "noindex"
			header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self'; font-src 'self'"
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'"
	}
}
