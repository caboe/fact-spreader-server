# Fact Spreader — environment template. Copy to .env and fill in. Never commit .env.
# Compose reads this file; the backend reads the same names from its environment.

APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-me
LIGHTRAG_DB_PASSWORD=replace-me
LIGHTRAG_API_KEY=replace-with-a-long-random-secret
INTERNAL_LLM_KEY=replace-with-a-long-random-secret
LIGHTRAG_INTERNAL_KEY=replace-with-a-different-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# First-run setup wizard. Required before an admin exists; generate with
# python -c "import secrets; print(secrets.token_urlsafe(24))". Never use a default.
SETUP_TOKEN=

# --- database / cache (compose service names)
POSTGRES_USER=factspreader
POSTGRES_DB=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://factspreader:replace-me@postgres:5432/app
LIGHTRAG_DB_USER=lightrag
LIGHTRAG_DB_NAME=lightrag
REDIS_URL=redis://redis:6379/0

# --- stock LightRAG
LIGHTRAG_BASE_URL=http://lightrag:9621
LIGHTRAG_TIMEOUT_SECONDS=180
LIGHTRAG_TOP_K=40
LIGHTRAG_CHUNK_TOP_K=20
# The diagnostic /retrieval page uses its own, smaller graph breadth. Graph candidates and
# passages share one token budget, so the check default (40) returned fewer passages than
# 10 and the page showed fewer documents, not more (DECISIONS.md D65).
LIGHTRAG_RAW_TOP_K=10
LIGHTRAG_RAW_CHUNK_TOP_K=20

# --- internal LLM gateway
INTERNAL_GATEWAY_URL=http://backend:8000/internal/llm/v1
LLM_INPUT_COST_PER_MTOK=0.30
LLM_OUTPUT_COST_PER_MTOK=0.50
MONTHLY_BUDGET_USD=15
USER_BUDGET_USD=15

# --- bootstrap providers/models (Phase 1; the operator UI replaces this later)
DEEPSEEK_API_KEY=
PROVIDER_CHAT_BASE_URL=https://api.deepseek.com/v1
PROVIDER_CHAT_MODEL=deepseek-flash
PROVIDER_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
PROVIDER_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OPENROUTER_API_KEY=
PROVIDER_VISION_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_VISION_MODEL=
VISION_ENABLED=false

# --- runtime
SUPPORTED_LANGUAGES=en,de,fr,es
RATE_LIMIT_PER_MINUTE=60
CORS_EXTENSION_ORIGINS=
