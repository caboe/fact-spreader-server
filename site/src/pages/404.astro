---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'This page is not part of the handbook. Start at the overview or search.',
  }}
>
  <div data-pagefind-ignore>
    <p>The page you asked for does not exist in this handbook.</p>
    <p>
      Go back to the <a href={import.meta.env.BASE_URL}>overview</a> or use the search above to
      find the topic you need.
    </p>
  </div>
</StarlightPage>
